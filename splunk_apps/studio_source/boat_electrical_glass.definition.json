        "extend": "ds_kpis",
        "query": "| search metric_name=venus.cpu.temp | sort _time | streamstats current=f last(value) as prev | stats latest(value) as value latest(prev) as prev list(value) as spark_mv | eval label=\"CPU \u00b0C\", value=round(value,1), delta=round(value-prev,1), spark=mvjoin(spark_mv, \",\")"
      }
    }
