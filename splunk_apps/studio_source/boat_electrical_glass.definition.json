  "dataSources": {
    "ds_kpis": {
      "type": "ds.search",
      "name": "Tessa Jane glass series",
      "options": {
        "query": "| mstats avg(_value) as value span=15m where index=sim_metrics AND (metric_name=battery.soc.house OR metric_name=battery.voltage.house OR metric_name=battery.voltage.starter OR metric_name=cabin.humidity OR metric_name=cabin.pressure OR metric_name=cabin.temp OR metric_name=solar.power.bow OR metric_name=solar.power.mid OR metric_name=solar.power.stern OR metric_name=solar.voltage.bow OR metric_name=solar.voltage.mid OR metric_name=solar.voltage.stern OR metric_name=venus.cpu.temp) by metric_name",
        "queryParameters": {
          "earliest": "$global_time.earliest$",
          "latest": "$global_time.latest$"
        },
        "refresh": "60s",
        "refreshType": "delay"
      }
    },
    "ds_bow_pwr": {
      "type": "ds.chain",
      "name": "FWD W",
      "options": {
        "extend": "ds_kpis",
        "query": "| search metric_name=solar.power.bow | sort _time | streamstats current=f last(value) as prev | stats latest(value) as value latest(prev) as prev list(value) as spark_mv | eval label=\"FWD W\", value=round(value,1), delta=round(value-prev,1), spark=mvjoin(spark_mv, \",\")"
      }
    },
    "ds_bow_v": {
      "type": "ds.chain",
      "name": "FWD V",
      "options": {
        "extend": "ds_kpis",
        "query": "| search metric_name=solar.voltage.bow | sort _time | streamstats current=f last(value) as prev | stats latest(value) as value latest(prev) as prev list(value) as spark_mv | eval label=\"FWD V\", value=round(value,2), delta=round(value-prev,2), spark=mvjoin(spark_mv, \",\")"
      }
    },
    "ds_mid_pwr": {
      "type": "ds.chain",
      "name": "MID W",
      "options": {
        "extend": "ds_kpis",
        "query": "| search metric_name=solar.power.mid | sort _time | streamstats current=f last(value) as prev | stats latest(value) as value latest(prev) as prev list(value) as spark_mv | eval label=\"MID W\", value=round(value,1), delta=round(value-prev,1), spark=mvjoin(spark_mv, \",\")"
      }
    },
    "ds_mid_v": {
      "type": "ds.chain",
      "name": "MID V",
      "options": {
        "extend": "ds_kpis",
        "query": "| search metric_name=solar.voltage.mid | sort _time | streamstats current=f last(value) as prev | stats latest(value) as value latest(prev) as prev list(value) as spark_mv | eval label=\"MID V\", value=round(value,2), delta=round(value-prev,2), spark=mvjoin(spark_mv, \",\")"
      }
    },
    "ds_stern_pwr": {
      "type": "ds.chain",
      "name": "AFT W",
      "options": {
        "extend": "ds_kpis",
        "query": "| search metric_name=solar.power.stern | sort _time | streamstats current=f last(value) as prev | stats latest(value) as value latest(prev) as prev list(value) as spark_mv | eval label=\"AFT W\", value=round(value,1), delta=round(value-prev,1), spark=mvjoin(spark_mv, \",\")"
      }
    },
    "ds_stern_v": {
      "type": "ds.chain",
      "name": "AFT V",
      "options": {
        "extend": "ds_kpis",
        "query": "| search metric_name=solar.voltage.stern | sort _time | streamstats current=f last(value) as prev | stats latest(value) as value latest(prev) as prev list(value) as spark_mv | eval label=\"AFT V\", value=round(value,2), delta=round(value-prev,2), spark=mvjoin(spark_mv, \",\")"
      }
    },
    "ds_house_soc": {
      "type": "ds.chain",
      "name": "House SOC %",
      "options": {
        "extend": "ds_kpis",
        "query": "| search metric_name=battery.soc.house | sort _time | streamstats current=f last(value) as prev | stats latest(value) as value latest(prev) as prev list(value) as spark_mv | eval label=\"House SOC %\", value=round(value,1), delta=round(value-prev,1), spark=mvjoin(spark_mv, \",\")"
      }
    },
    "ds_house_v": {
      "type": "ds.chain",
      "name": "House V",
      "options": {
        "extend": "ds_kpis",
        "query": "| search metric_name=battery.voltage.house | sort _time | streamstats current=f last(value) as prev | stats latest(value) as value latest(prev) as prev list(value) as spark_mv | eval label=\"House V\", value=round(value,2), delta=round(value-prev,2), spark=mvjoin(spark_mv, \",\")"
      }
    },
    "ds_starter_v": {
      "type": "ds.chain",
      "name": "Starter V",
      "options": {
        "extend": "ds_kpis",
        "query": "| search metric_name=battery.voltage.starter | sort _time | streamstats current=f last(value) as prev | stats latest(value) as value latest(prev) as prev list(value) as spark_mv | eval label=\"Starter V\", value=round(value,2), delta=round(value-prev,2), spark=mvjoin(spark_mv, \",\")"
      }
    },
    "ds_cabin_t": {
      "type": "ds.chain",
      "name": "Cabin \u00b0C",
      "options": {
        "extend": "ds_kpis",
        "query": "| search metric_name=cabin.temp | sort _time | streamstats current=f last(value) as prev | stats latest(value) as value latest(prev) as prev list(value) as spark_mv | eval label=\"Cabin \u00b0C\", value=round(value,1), delta=round(value-prev,1), spark=mvjoin(spark_mv, \",\")"
      }
    },
    "ds_cabin_h": {
      "type": "ds.chain",
      "name": "Cabin RH %",
      "options": {
        "extend": "ds_kpis",
        "query": "| search metric_name=cabin.humidity | sort _time | streamstats current=f last(value) as prev | stats latest(value) as value latest(prev) as prev list(value) as spark_mv | eval label=\"Cabin RH %\", value=round(value,1), delta=round(value-prev,1), spark=mvjoin(spark_mv, \",\")"
      }
    },
    "ds_cabin_p": {
      "type": "ds.chain",
      "name": "hPa",
      "options": {
        "extend": "ds_kpis",
        "query": "| search metric_name=cabin.pressure | sort _time | streamstats current=f last(value) as prev | stats latest(value) as value latest(prev) as prev list(value) as spark_mv | eval label=\"hPa\", value=round(value,1), delta=round(value-prev,1), spark=mvjoin(spark_mv, \",\")"
      }
    },
    "ds_venus": {
      "type": "ds.chain",
      "name": "CPU \u00b0C",
